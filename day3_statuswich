import time

import gymnasium as gym
import mani_skill.envs
import numpy as np


SEED = 2
GAIN = 6.0
MAX_ACTION = 0.3
TOLERANCE = 0.005

LIFT_HEIGHT = 0.12
MOVE_OFFSET = np.array([0.10, 0.0, 0.0], dtype=np.float32)

CLOSE_STEPS = 20
RELEASE_STEPS = 20
STAGE_TIMEOUT = 150
MAX_STEPS = 1000


def to_numpy(tensor):
    return tensor[0].detach().cpu().numpy().copy()


def check_base_rotation(base):
    root_q = to_numpy(base.agent.robot.pose.q)
    if not np.allclose(
        np.abs(root_q),
        [1.0, 0.0, 0.0, 0.0],
        atol=1e-4,
    ):
        raise RuntimeError("底座存在旋转，需要先转换控制误差的坐标系。")


def main():
    env = gym.make(
        "PickCube-v1",
        robot_uids="panda",
        num_envs=1,
        sim_backend="cpu",
        obs_mode="state",
        control_mode="pd_ee_delta_pos",
        render_mode="human",
        max_episode_steps=MAX_STEPS,
    )

    try:
        obs, info = env.reset(seed=SEED)
        base = env.unwrapped
        check_base_rotation(base)

        initial_cube_pos = to_numpy(base.cube.pose.p)
        initial_cube_z = float(initial_cube_pos[2])

        # 接近目标：初始方块上方
        target = initial_cube_pos.copy()
        target[2] += LIFT_HEIGHT

        stage = "approach"
        stage_steps = 0

        # 后面进入对应阶段时赋值
        grasp_tcp_pos = None
        place_target = None

        print("动作空间：", env.action_space)
        print("初始方块位置：", initial_cube_pos)
        print("开始：接近方块上方")

        for step in range(MAX_STEPS):
            tcp_pos = to_numpy(base.agent.tcp.pose.p)

            # 1. 根据阶段控制夹爪
            if stage in ("approach", "descend", "release", "retreat"):
                gripper = 1.0
            else:
                gripper = -1.0

            # 2. 所有阶段共用同一段移动代码
            error = target - tcp_pos
            move = np.clip(
                GAIN * error,
                -MAX_ACTION,
                MAX_ACTION,
            )

            action = np.array(
                [move[0], move[1], move[2], gripper],
                dtype=np.float32,
            ).reshape(env.action_space.shape)

            obs, reward, terminated, truncated, info = env.step(action)
            env.render()
            time.sleep(0.02)

            stage_steps += 1

            # 3. 读取动作执行后的状态
            tcp_pos = to_numpy(base.agent.tcp.pose.p)
            cube_pos = to_numpy(base.cube.pose.p)

            distance = np.linalg.norm(target - tcp_pos)
            reached = distance < TOLERANCE

            next_stage = None

            # 4. 判断阶段完成条件，并设置下一阶段的固定目标
            if stage == "approach":
                if reached:
                    target = cube_pos.copy()
                    next_stage = "descend"
                    print("到达上方，开始下降")

            elif stage == "descend":
                if reached:
                    # 固定当前位置，在这里闭合夹爪
                    target = tcp_pos.copy()
                    next_stage = "grasp"
                    print("下降完成，开始闭合夹爪")

            elif stage == "grasp":
                if stage_steps >= CLOSE_STEPS:
                    grasp_tcp_pos = tcp_pos.copy()

                    target = grasp_tcp_pos.copy()
                    target[2] += LIFT_HEIGHT

                    next_stage = "lift"
                    print("闭合完成，开始抬升")

            elif stage == "lift":
                if reached:
                    height_increase = cube_pos[2] - initial_cube_z

                    if height_increase < 0.05:
                        print("抓取失败：TCP 已抬升，但方块没有明显升高")
                        break

                    # 在当前高度横向移动 0.10 米
                    target = tcp_pos.copy() + MOVE_OFFSET

                    # 放置位置与抓取位置高度相同
                    place_target = grasp_tcp_pos.copy() + MOVE_OFFSET

                    next_stage = "transport"
                    print("方块抬起成功，开始横向搬运")

            elif stage == "transport":
                if cube_pos[2] - initial_cube_z < 0.04:
                    print("搬运失败：方块可能已掉落")
                    break

                if reached:
                    target = place_target.copy()
                    next_stage = "place"
                    print("搬运完成，开始下降放置")

            elif stage == "place":
                if reached:
                    target = tcp_pos.copy()
                    next_stage = "release"
                    print("到达放置位置，开始松开夹爪")

            elif stage == "release":
                if stage_steps >= RELEASE_STEPS:
                    target = tcp_pos.copy()
                    target[2] += LIFT_HEIGHT

                    next_stage = "retreat"
                    print("松开完成，夹爪向上撤离")

            elif stage == "retreat":
                if reached:
                    expected_cube_pos = initial_cube_pos + MOVE_OFFSET

                    xy_error = np.linalg.norm(
                        cube_pos[:2] - expected_cube_pos[:2]
                    )
                    z_error = abs(cube_pos[2] - initial_cube_z)

                    if xy_error < 0.03 and z_error < 0.015:
                        print("完成：方块已搬运并放置到目标附近")
                    else:
                        print(
                            "动作执行结束，但放置位置存在偏差："
                            f"水平误差={xy_error:.4f} m，"
                            f"高度误差={z_error:.4f} m"
                        )
                    break

            # 5. 切换阶段时清零计数器
            if next_stage is not None:
                stage = next_stage
                stage_steps = 0

            elif stage_steps >= STAGE_TIMEOUT:
                print(
                    f"阶段超时：{stage}，"
                    f"距离目标还有 {distance:.4f} m"
                )
                break

            # 这里演示完整搬运流程，只在时间上限时停止。
            # PickCube 原任务的 terminated 不作为本流程完成条件。
            if bool(truncated.item()):
                print(f"达到环境时间上限，当前阶段：{stage}")
                break

        else:
            print(f"达到循环上限，当前阶段：{stage}")

        input("观察完成后，在终端按 Enter 关闭窗口……")

    finally:
        env.close()


if __name__ == "__main__":
    main()